# Ignore build outputs recursively
**/bin/
**/obj/
**/TestResults/
**/publish/
**/out/
**/dist/

# Ignore user-specific and IDE files
**/*.user
**/*.suo
**/*.userosscache
**/*.sln.docstates
.vs/
.vscode/
.idea/

# Ignore NuGet packages and cache
**/*.nupkg
**/*.snupkg
packages/
.nuget/
**/packages/

# Ignore Docker-related files
Dockerfile.*
docker-compose.override.yml
**/*.tar
**/*.gz
**/*.img
**/*.container

# Ignore logs and temp files
**/*.log
**/*.tmp
**/*.bak
**/*.old
**/*.orig

# Ignore OS-specific files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
**/*.swp

# Ignore test coverage and diagnostics
**/*.trx
**/*.coverage
**/*.coveragexml

# Ignore build artifacts and lock files
**/*.dll
**/*.exe
**/*.app
**/*.pdb
**/*.cache
**/*.db
**/*.db-shm
**/*.db-wal
**/*.pid
**/*.lock.json

# Ignore solution-level cache
**/*.sln.cache
**/*.csproj.user
