{
  "ApplicationSettings": {
    "Name": "CatalogService",
    "Description": "Product Catalog Service",
    "Version": 1.0,
    "Url": "http://+:5012",
    "Log": "catalog.log"
  },
  "MongoSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "CatalogDatabase",
    "CollectionName": "Items"
  },
  "JwtSettings": {
    "Key": "fault3r-eShop-JsonWebToken-SymmetricSecureKey",
    "Issuer": "fault3r.eShop",
    "Audience": "CatalogService"
  },
  "RabbitmqSettings": {
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "catalog-exchange",
    "QueueName": "catalog-queue",
    "RoutingKey": "catalog"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}