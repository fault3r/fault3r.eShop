{
  "ApplicationSettings": {
    "Name": "CatalogManagementService",
    "Description": "fault3r.eShop - Catalog Management Service",
    "Version": 1.0,
    "Url": "http://+:5012",
    "Log": "logs.txt"
  },
  "MongoSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "CatalogManagementDatabase",
    "CollectionName": "Items"
  },
  "JwtSettings": {
    "Key": "fault3r-eShop-JsonWebToken-SymmetricSecureKey",
    "Issuer": "fault3r.eShop",
    "Audience": "CatalogManagementService"
  },
  "RabbitmqSettings": {
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "catalog-exchange",
    "QueueName": "catalog-queue",
    "RoutingKey": "catalog"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}